# AyuDiet Connect - Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Connection String (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://localhost:27017/ayudiet
# Example Atlas: mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/ayudiet?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/ayudiet

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:3000
